# Database (required on Vercel — use Supabase/Neon/Railway Postgres connection string)
# Local:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hr_payroll_ng?schema=public"
# Production (Supabase): use the Transaction pooler URL (port 6543), e.g.
# DATABASE_URL="postgresql://postgres.xxx:PASSWORD@aws-0-…pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=30&sslmode=require"

# NextAuth (required on Vercel — build fails without NEXTAUTH_SECRET)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-secret-in-production"

# Vercel production example:
# NEXTAUTH_URL="https://your-app.vercel.app"
# NEXTAUTH_SECRET="<run: openssl rand -base64 32>"

# Google Workspace sync (optional)
# Create an OAuth client in Google Cloud Console (Web application)
# Authorized redirect URI: {NEXTAUTH_URL}/api/integrations/google-drive/callback
# Enable APIs: Google Drive API + Google Sheets API
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional default Shared Drive / folder ID for HR files
# GOOGLE_DRIVE_FOLDER_ID=""
# Optional: auto-share synced Sheets/files with everyone @yourcompany.com
# GOOGLE_WORKSPACE_DOMAIN="yourcompany.com"
# Optional: attendance / clock machine
# Map each employee's "Clock machine ID" to the biometric AcNo/PIN, then import CSV from Attendance.

# HR Desk uses the same Google Workspace connection and needs Gmail scopes.
# After deploy, reconnect Google in Settings so Gmail read + draft access is granted.

