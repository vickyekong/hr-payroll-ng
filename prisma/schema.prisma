generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  HR_ADMIN
  FINANCE
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  SUSPENDED
  ON_LEAVE
  SICK_LEAVE
  FIRED
  RESIGNED
}

enum EmployeeSex {
  MALE
  FEMALE
}

enum EmploymentType {
  FULL_TIME
  CONTRACT
}

enum PayrollRunStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  PAID
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  UNPAID
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Company {
  id             String   @id @default(cuid())
  name           String
  address        String?
  logoUrl        String?
  /// Primary accent (hex, e.g. #14919b). Null = OmniPeople lagoon default.
  brandAccentHex String?
  /// Sidebar / ink color (hex). Null = OmniPeople ink default.
  brandInkHex    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  statutoryConfig       StatutoryConfig?
  users                 User[]
  employees             Employee[]
  departments           Department[]
  payrollRuns           PayrollRun[]
  taxBands              TaxBand[]
  googleDriveIntegration GoogleDriveIntegration?
  notifications         Notification[]
  shiftTemplates        ShiftTemplate[]
  attendanceSettings    AttendanceSettings?
  attendancePunches     AttendancePunch[]
  attendanceDays        AttendanceDay[]
  hrDeskMessages        HrDeskMessage[]
  employeeLifecycles    EmployeeLifecycle[]
  changeRequests        EmployeeChangeRequest[]
  jobDescriptions       JobDescription[]
}

model Department {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model JobDescription {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model StatutoryConfig {
  id                    String  @id @default(cuid())
  companyId             String  @unique
  company               Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Pension rates (basis points: 800 = 8%)
  pensionEmployeeRate   Int     @default(800)
  pensionEmployerRate   Int     @default(1000)
  pensionBasis          String  @default("BASIC_HOUSING_TRANSPORT")

  // NHF
  nhfEnabled            Boolean @default(true)
  nhfRate               Int     @default(250) // 2.5%

  // NSITF (employer only)
  nsitfRate             Int     @default(100) // 1%

  // Tax relief mode: NTA2025 (tax-free threshold) or CRA (legacy)
  taxReliefMode         String  @default("NTA2025")
  taxFreeThresholdKobo  BigInt  @default(80000000) // ₦800,000 annual
  craFixedKobo          BigInt  @default(20000000) // ₦200,000 (legacy CRA)
  craPercentBps         Int     @default(100)      // 1% of gross
  craGrossPercentBps    Int     @default(2000)     // 20% of gross
  rentReliefCapKobo     BigInt  @default(50000000) // ₦500,000
  minimumWageExemptKobo BigInt  @default(84000000) // ₦840,000 annual (₦70k/month)

  updatedAt             DateTime @updatedAt
}

model TaxBand {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lowerBoundKobo BigInt
  upperBoundKobo BigInt? // null = no upper limit
  rateBps     Int     // 1500 = 15%
  sortOrder   Int
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?

  @@index([companyId, sortOrder])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId   String?  @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payrollRunsCreated  PayrollRun[] @relation("CreatedBy")
  payrollRunsApproved PayrollRun[] @relation("ApprovedBy")
  leaveApprovals      LeaveRequest[] @relation("LeaveApprover")
  auditLogs           AuditLog[]
  notifications       Notification[]
  hrDeskAssigned      HrDeskMessage[] @relation("HrDeskAssignee")
}

model Employee {
  id                  String         @id @default(cuid())
  companyId           String
  company             Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeCode        String
  firstName           String
  lastName            String
  department          String
  jobTitle            String
  employmentType      EmploymentType @default(FULL_TIME)
  status              EmployeeStatus @default(ACTIVE)
  sex                 EmployeeSex?
  startDate           DateTime
  endDate             DateTime?

  // Bank & statutory IDs
  bankName            String?
  bankAccountNumber   String?
  tin                 String?
  rsaPin              String?
  nhfNumber           String?

  // Compensation (all in kobo)
  basicSalaryKobo     BigInt
  housingAllowanceKobo BigInt @default(0)
  transportAllowanceKobo BigInt @default(0)
  otherTaxableAllowancesKobo BigInt @default(0)
  nonTaxableReimbursementsKobo BigInt @default(0)

  // Optional rent for NTA2025 relief
  annualRentKobo      BigInt @default(0)

  nextOfKinName       String?
  nextOfKinPhone      String?

  // Biometric / clock-in machine badge or user ID
  clockDeviceId       String?

  user                User?
  documents           EmployeeDocument[]
  payslips            Payslip[]
  leaveRequests       LeaveRequest[]
  leaveBalances       LeaveBalance[]
  payrollAdjustments  PayrollAdjustment[]
  shiftAssignment     EmployeeShiftAssignment?
  attendancePunches   AttendancePunch[]
  attendanceDays      AttendanceDay[]
  hrDeskMessages      HrDeskMessage[]
  lifecycles          EmployeeLifecycle[]
  changeRequests      EmployeeChangeRequest[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([companyId, employeeCode])
  @@unique([companyId, clockDeviceId])
  @@index([companyId, status])
}

model EmployeeDocument {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name       String
  fileUrl    String
  uploadedAt DateTime @default(now())
}

model PayrollRun {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodMonth Int
  periodYear  Int
  status      PayrollRunStatus @default(DRAFT)
  createdById String
  createdBy   User             @relation("CreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy  User?            @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt  DateTime?
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  payslips    Payslip[]
  adjustments PayrollAdjustment[]

  @@unique([companyId, periodMonth, periodYear])
  @@index([companyId, status])
}

model PayrollAdjustment {
  id            String     @id @default(cuid())
  payrollRunId  String
  payrollRun    PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type          String     // BONUS, LOAN_DEDUCTION, ADVANCE, UNPAID_LEAVE
  amountKobo    BigInt     // positive = earning, negative = deduction
  description   String?
  createdAt     DateTime   @default(now())

  @@index([payrollRunId, employeeId])
}

model Payslip {
  id                  String     @id @default(cuid())
  payrollRunId        String
  payrollRun          PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  grossPayKobo        BigInt
  basicSalaryKobo     BigInt
  housingAllowanceKobo BigInt
  transportAllowanceKobo BigInt
  otherAllowancesKobo BigInt
  bonusesKobo         BigInt @default(0)

  payeKobo            BigInt
  pensionEmployeeKobo BigInt
  pensionEmployerKobo BigInt
  nhfKobo             BigInt @default(0)
  nsitfKobo           BigInt @default(0)
  otherDeductionsKobo BigInt @default(0)

  netPayKobo          BigInt

  // YTD snapshots at time of generation
  ytdGrossKobo        BigInt @default(0)
  ytdPayeKobo         BigInt @default(0)
  ytdNetKobo          BigInt @default(0)

  breakdown           Json?
  generatedAt         DateTime @default(now())

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

model LeaveRequest {
  id          String             @id @default(cuid())
  employeeId  String
  employee    Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        LeaveType
  startDate   DateTime
  endDate     DateTime
  days        Int
  reason      String?
  status      LeaveRequestStatus @default(PENDING)
  approvedById String?
  approvedBy  User?              @relation("LeaveApprover", fields: [approvedById], references: [id])
  approvedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([employeeId, status])
}

model LeaveBalance {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType
  year         Int
  entitledDays Int
  usedDays     Int       @default(0)

  @@unique([employeeId, leaveType, year])
}

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String?
  action      String
  entityType  String
  entityId    String
  performedById String
  performedBy User     @relation(fields: [performedById], references: [id])
  changes     Json?
  timestamp   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([performedById])
  @@index([companyId, timestamp])
}

model Notification {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String
  linkUrl    String
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([companyId, createdAt])
}

model GoogleDriveIntegration {
  id                   String   @id @default(cuid())
  companyId            String   @unique
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  refreshToken         String
  email                String?
  folderId             String?
  staffSpreadsheetId   String?
  payrollSpreadsheetId String?
  lastStaffSyncAt      DateTime?
  lastPayrollSyncAt    DateTime?
  lastHrMailSyncAt     DateTime?
  connectedAt          DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

enum HrDeskCategory {
  LEAVE
  RESIGNATION
  COMPLAINT
  INQUIRY
  PAYROLL
  GENERAL
}

enum HrDeskStatus {
  NEW
  TRIAGED
  ASSIGNED
  APPROVED
  REJECTED
  CLOSED
}

model HrDeskMessage {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  gmailMessageId  String
  gmailThreadId   String?
  fromEmail       String
  fromName        String?
  subject         String
  snippet         String
  bodyText        String?
  receivedAt      DateTime
  category        HrDeskCategory @default(GENERAL)
  status          HrDeskStatus   @default(NEW)
  employeeId      String?
  employee        Employee?      @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  /// HR portal user responsible for triaging / closing this mail
  assigneeUserId  String?
  assigneeUser    User?          @relation("HrDeskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  leaveRequestId  String?
  draftMessageId  String?
  notes           String?
  processedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([companyId, gmailMessageId])
  @@index([companyId, status, receivedAt])
  @@index([companyId, category])
  @@index([employeeId])
  @@index([assigneeUserId])
}

enum AttendanceDayStatus {
  PRESENT
  LATE
  PARTIAL
  ABSENT
  ON_LEAVE
  OFF
}

model AttendanceSettings {
  id                      String  @id @default(cuid())
  companyId               String  @unique
  company                 Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Fixed penalty per missed shift in kobo. If 0, use daily basic rate.
  missedShiftPenaltyKobo  BigInt  @default(0)
  /// Minutes after shift start before marking LATE
  lateGraceMinutes        Int     @default(15)
  /// Minimum minutes on site to count as PRESENT (else PARTIAL)
  minPresentMinutes       Int     @default(240)
  updatedAt               DateTime @updatedAt
}

model ShiftTemplate {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  /// "HH:mm" 24h local time
  startTime     String
  endTime       String
  /// Mon=0 … Sun=6 as bitmask string length 7, e.g. "1111100" = Mon–Fri
  workDays      String   @default("1111100")
  graceMinutes  Int      @default(15)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignments   EmployeeShiftAssignment[]
  attendanceDays AttendanceDay[]

  @@unique([companyId, name])
  @@index([companyId])
}

model EmployeeShiftAssignment {
  id         String        @id @default(cuid())
  employeeId String        @unique
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId    String
  shift      ShiftTemplate @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  updatedAt  DateTime      @updatedAt

  @@index([shiftId])
}

model AttendancePunch {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deviceUserId String
  employeeId   String?
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  punchedAt    DateTime
  punchType    String?   // IN, OUT, or unknown from machine
  source       String    @default("CSV_IMPORT")
  importBatch  String?
  rawLine      String?
  createdAt    DateTime  @default(now())

  @@unique([companyId, deviceUserId, punchedAt])
  @@index([companyId, punchedAt])
  @@index([employeeId, punchedAt])
}

model AttendanceDay {
  id              String              @id @default(cuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate        DateTime
  shiftId         String?
  shift           ShiftTemplate?      @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  status          AttendanceDayStatus
  clockInAt       DateTime?
  clockOutAt      DateTime?
  workedMinutes   Int                 @default(0)
  lateMinutes     Int                 @default(0)
  expectedMinutes Int                 @default(0)
  penaltyKobo     BigInt              @default(0)
  notes           String?
  compiledAt      DateTime            @default(now())

  @@unique([employeeId, workDate])
  @@index([companyId, workDate, status])
  @@index([companyId, status])
}

enum LifecycleKind {
  ONBOARDING
  OFFBOARDING
}

enum LifecycleStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum LifecycleTaskStatus {
  PENDING
  DONE
  SKIPPED
}

model EmployeeLifecycle {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind        LifecycleKind
  status      LifecycleStatus @default(OPEN)
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  notes       String?
  tasks       EmployeeLifecycleTask[]

  @@index([companyId, status, kind])
  @@index([employeeId, kind, status])
}

model EmployeeLifecycleTask {
  id            String              @id @default(cuid())
  lifecycleId   String
  lifecycle     EmployeeLifecycle   @relation(fields: [lifecycleId], references: [id], onDelete: Cascade)
  key           String
  title         String
  description   String?
  href          String?
  status        LifecycleTaskStatus @default(PENDING)
  sortOrder     Int                 @default(0)
  completedAt   DateTime?
  completedById String?
  createdAt     DateTime            @default(now())

  @@unique([lifecycleId, key])
  @@index([lifecycleId, status])
}

enum ChangeRequestType {
  BANK
  TAX_RELIEF
  NEXT_OF_KIN
  ADDRESS
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model EmployeeChangeRequest {
  id           String              @id @default(cuid())
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         ChangeRequestType
  status       ChangeRequestStatus @default(PENDING)
  payload      Json
  note         String?
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([companyId, status, createdAt])
  @@index([employeeId, status])
}

